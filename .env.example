# Backend model configuration
# Copy this file to .env or backend/.env, then fill in your real key.
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# OpenAI-compatible endpoint used by ChatOpenAI/OpenAIEmbeddings.
OPENAI_API_BASE=########

# Model names
CHAT_MODEL_NAME=########
EMBEDDING_MODEL_NAME=########

# Backend runtime
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL and auth
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Docker Compose（可选）
# Compose 会通过根目录 .env 做变量替换；stack 内的 DATABASE_URL 由 compose 注入并指向 db 服务。
BACKEND_PUBLISH_PORT=8000
FRONTEND_PUBLISH_PORT=8080
DOCKER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_secret_change_me
POSTGRES_DB=ragapp
# 宿主连接 Docker 内 Postgres（DBeaver / pgAdmin）；若本机已占用 5432，改为例如 5433
POSTGRES_PUBLISH_PORT=5432

# Docker：`web` 镜像不再拉 Node，须在宿主机执行 `npm --prefix frontend run build` 后再 compose，或运行 .\scripts\docker-up.ps1
# 仅后端基础镜像可调（可选）：
# DOCKER_PYTHON_IMAGE=python:3.12-slim-bookworm
# 构建 api 时 apt 走 Debian 官方源若遇 502，可改用国内镜像主机（不含路径）；默认 http://deb.debian.org
# DEBIAN_REPO_MIRROR=http://mirrors.aliyun.com
